{
  "manifest_version": 3,
  "name": "JobPilot SG — Review & Fill",
  "version": "0.10.10",
  "description": "Prepare saved facts and editable AI drafts for supported application forms. Fill once, attach files separately and submit manually.",
  "minimum_chrome_version": "106",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {"service_worker": "background.js", "type": "module"},
  "externally_connectable": {"matches": ["http://localhost/*", "http://127.0.0.1/*"]},
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {"default_popup": "popup.html", "default_title": "Review and fill supported applications"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
