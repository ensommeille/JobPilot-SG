# Local Docker Compose only. These ports are bound to 127.0.0.1.
JOBPILOT_DB_PORT=5432
JOBPILOT_REDIS_PORT=6379
JOBPILOT_API_PORT=8000
JOBPILOT_WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Replace both values before sharing a deployment. Do not commit your .env.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JOBPILOT_DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-password

# Copy the installed extension ID from chrome://extensions after loading it.
EXTENSION_CLIENT_IDS=[]
EXTENSION_WEB_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Default Docker extension pairing is localhost:5173 -> localhost:8000.
# Custom ports need a separately reviewed extension allowlist; they are not auto-trusted.
