DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# M4 live LLM provider. Keep real keys only in backend/.env or CI secrets.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.25

# Qwen example for Alibaba Cloud Model Studio Singapore:
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.8-flash
